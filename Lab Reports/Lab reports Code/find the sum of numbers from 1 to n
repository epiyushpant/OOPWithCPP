#include <iostream>
using namespace std;

int main()
{
    int n, sum = 0;

    // Input the value of n
    cout << "Enter a number: ";
    cin >> n;

    // Find the sum of numbers from 1 to n
    for (int i = 1; i <= n; i++)
    {
        sum = sum + i;
    }

    // Display the result
    cout << "Sum of numbers from 1 to " << n << " = " << sum;

    return 0;
}
